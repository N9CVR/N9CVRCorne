if SHIELD_N9CVR_OLED_UI_ANY

config ZMK_DISPLAY
    default y

# ZMK_DISPLAY_STATUS_SCREEN_CUSTOM is a member of a choice. Re-open the
# choice and change its default; assigning a default to the member itself
# causes a Kconfig warning and does not select the custom screen.
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL

config LV_FONT_MONTSERRAT_10
    default y

config LV_FONT_MONTSERRAT_14
    default y

endif

if SHIELD_N9CVR_OLED_UI_LEFT

config ZMK_WIDGET_BATTERY_STATUS
    default y

config ZMK_WIDGET_BATTERY_STATUS_SHOW_PERCENTAGE
    default y

config ZMK_WIDGET_OUTPUT_STATUS
    default y

config ZMK_WIDGET_LAYER_STATUS
    default y

config ZMK_WIDGET_WPM_STATUS
    default y

endif

if SHIELD_N9CVR_OLED_UI_RIGHT

config ZMK_WIDGET_PERIPHERAL_STATUS
    default y

endif
